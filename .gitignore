app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing secrets (also listed in android/.gitignore)
android/key.properties
*.jks
*.keystore

# Reference, analysis, etc.
ignore/

# promotional recordings
footage/
